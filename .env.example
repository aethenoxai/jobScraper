# Job Scraper configuration. Copy to .env (`pnpm run setup` does this) and fill in.
# NEVER commit .env — it will hold your API keys and passwords.
# Wrap values containing #, $ or spaces in single quotes: APP_PASSWORD='p#ss$word'

# Where the database and generated files live
DATA_DIR=./data
# Web UI binding. Keep 127.0.0.1 unless you know what you are doing.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# pretty (readable lines) | json (one JSON object per line, for log collectors)
# LOG_FORMAT=pretty

# --- Optional: everything below is set only if you use it (docs/CONFIGURATION.md lists every option) ---

# AI provider keys (choose the provider and models in Settings → AI provider)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=     # only if your OpenAI-compatible server needs one
# OLLAMA_BASE_URL=               # if Ollama isn't at http://127.0.0.1:11434/api

# Job sources that need a key
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# BRAVE_SEARCH_API_KEY=          # web discovery with Brave Search (or use SearXNG, set in the source)
# SCRAPLING_PYTHON=              # a Python with Scrapling, instead of .scrapling/venv (set up by `pnpm run setup`)

# Telegram notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_ID=

# Sending application emails (see docs/setup/email.md)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Sender address (defaults to SMTP_USERNAME) and TLS mode (true = TLS from the start, usually port 465;
# otherwise STARTTLS is required, usually port 587).
# SMTP_FROM=
# SMTP_SECURE=
# Only for a mail server on your own network with its own (self-signed) certificate:
# SMTP_ALLOW_SELF_SIGNED=true
# Optional: send from Gmail/Outlook with OAuth instead of an app password (see docs/setup/email.md)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=

# Reading replies for tracking (only if your provider isn't detected automatically; see docs/setup/email.md)
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_SECURE=             # defaults to true on port 993
# IMAP_USERNAME=           # only if different from SMTP_USERNAME (then IMAP_PASSWORD is required)
# IMAP_PASSWORD=
# IMAP_ALLOW_SELF_SIGNED=true   # only for a mail server on your own network

# Access (Job Scraper only answers on this computer by default)
# APP_PASSWORD=            # required if HOST is not 127.0.0.1 or APP_ALLOWED_HOSTS is set (8+ characters)
# APP_ALLOWED_HOSTS=       # extra host names allowed in the address bar, e.g. jobs.home.lan
# JOB_SCRAPER_BROWSER_HEADLESS=   # true = apply without a visible browser window (Docker/servers)
# TZ=                      # Docker only: your time zone, e.g. Europe/Berlin
# JOB_SCRAPER_ALLOW_PRIVATE_URLS is for the automated tests only (fixture sites on localhost). Never set it:
# it lets job pages and the website-apply browser reach your own network.
