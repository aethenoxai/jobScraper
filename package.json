{
  "name": "job-scraper",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "A local-first job-search assistant: finds matching jobs, tailors truthful CVs and letters, helps you apply, and tracks replies.",
  "homepage": "https://github.com/aethenoxai/jobScraper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aethenoxai/jobScraper.git"
  },
  "bugs": {
    "url": "https://github.com/aethenoxai/jobScraper/issues"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"pnpm dev:web\" \"pnpm dev:worker\"",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "concurrently -k -n web,worker \"pnpm start:web\" \"pnpm start:worker\"",
    "lint": "eslint .",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "setup": "tsx scripts/setup.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "dev:web": "tsx scripts/web.ts dev",
    "dev:worker": "node --watch --import tsx src/worker/index.ts --dev",
    "start:web": "tsx scripts/web.ts start",
    "start:worker": "tsx src/worker/index.ts",
    "eval:cv": "tsx evals/cv-extraction.ts",
    "eval:matching": "tsx evals/matching.ts",
    "eval:tailoring": "tsx evals/tailoring.ts",
    "eval:inbox": "tsx evals/inbox-classifier.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.70",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.61",
    "ai": "^7.0.124",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "imapflow": "^2.1.2",
    "mailparser": "^3.9.32",
    "mammoth": "^1.13.0",
    "next": "16.3.8",
    "node-notifier": "^10.0.1",
    "nodemailer": "^10.0.13",
    "ollama-ai-provider-v2": "^4.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "^1.8.1",
    "word-extractor": "1.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.0",
    "@types/node-notifier": "^8.0.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.13",
    "@types/word-extractor": "1.0.6",
    "concurrently": "^10.0.5",
    "docx": "^9.8.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "smtp-server": "^3.19.16",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22"
  }
}
