# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Job Scraper — local secrets and user data (never commit)
.env
!.env.example
/data/
# Backups copied out of Docker (they hold your database and tokens)
/backups/
/.e2e-data/
/test-results/
/playwright-report/
/.superpowers/

# Written by `next dev` for coding assistants; not part of the project
/AGENTS.md
/CLAUDE.md

# Scrapling's Python environment (created by `pnpm run setup`) and Python caches
/.scrapling/
__pycache__/
.pytest_cache/
# Claude Code: personal settings and worktrees stay local (the shared skills in .claude/skills are committed)
/.claude/settings.local.json
/.claude/worktrees/
